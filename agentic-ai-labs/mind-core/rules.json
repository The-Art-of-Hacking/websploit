{
  "version": 1,
  "echo": {
    "id": "generic-echo",
    "text": "No matching rule for lab {lab}. Prompt length {prompt_length}. Excerpt: {prompt_excerpt}"
  },
  "rules": [
    {
      "id": "mind-core-ping",
      "match_type": "contains",
      "match": "mind-core ping",
      "text": "mind-core deterministic backend is ready."
    },
    {
      "id": "mind-core-help",
      "match_type": "contains",
      "match": "mind-core help",
      "text": "POST /v1/complete with a JSON prompt. Optional lab and metadata are accepted and are not executed."
    },
    {
      "id": "acknowledge-lab",
      "match_type": "contains",
      "match": "acknowledge lab",
      "text": "Acknowledged lab {lab}."
    },
    {
      "id": "mind-core-self-check",
      "lab": "mind-core",
      "match_type": "exact",
      "match": "self-check",
      "text": "mind-core self-check ok."
    },
    {
      "id": "echo-chamber-status",
      "lab": "echo-chamber",
      "match_type": "contains",
      "match": "ops status",
      "text": "disk"
    },
    {
      "id": "echo-chamber-web",
      "lab": "echo-chamber",
      "match_type": "contains",
      "match": "render status banner",
      "text": "<div class=\"status-banner\">WEBSPLOIT{UN3SC4P3D_HTML_S1NK}</div>"
    },
    {
      "id": "echo-chamber-sql",
      "lab": "echo-chamber",
      "match_type": "contains",
      "match": "lookup maintenance note",
      "text": "' UNION SELECT value FROM secrets WHERE name='sql' --"
    },
    {
      "id": "echo-chamber-shell",
      "lab": "echo-chamber",
      "match_type": "contains",
      "match": "run health command",
      "text": "cat flags/shell.txt"
    }
  ]
}
